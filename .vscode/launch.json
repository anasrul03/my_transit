    "version": "0.2.0",
    "configurations": [
        {
            "name": "my_transit",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define",
                "ACCESS_TOKEN=pk.your_mapbox_token_here"
            ]
        },
        {
            "name": "my_transit (profile mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define",
                "ACCESS_TOKEN=pk.your_mapbox_token_here"
            ]
        },
        {
            "name": "my_transit (release mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--dart-define",
                "ACCESS_TOKEN=pk.your_mapbox_token_here"
            ]
        }
    ]
}